# W25Q128JV supports quad I/O: twice the flash bandwidth of the DIO default.
# Matters a lot here: core 1 reads the watch dial (and its code) from flash.
choice ESPTOOLPY_FLASHMODE
	default ESPTOOLPY_FLASHMODE_QIO
endchoice

# Core 0 (PROCPU): Wi-Fi/BLE, audio, storage, power, sensors, touch.
if BOARD_ESP32S3_TOUCH_AMOLED_1_75_ESP32S3_PROCPU

# ESP32-S3R8: the in-package 8 MB PSRAM is octal (size comes from &psram0).
choice SPIRAM_MODE
	default SPIRAM_MODE_OCT
	depends on ESP_SPIRAM
endchoice

choice SPIRAM_SPEED
	default SPIRAM_SPEED_80M
	depends on ESP_SPIRAM
endchoice

# I2C-attached drivers log from the system workqueue; 1 KB is too tight.
config SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

# Zephyr workaround: with the simple-boot image format, soc/espressif/esp32s3/
# memory.h takes core 0's top of RAM as 0x3fce9704 (shared buffers end), while
# core 1 (MCUboot format) uses the IPC area start, 0x3fce5000. Core 0 then
# carves out core 1's 128 KB from 18 KB too high, and its heap overlaps the
# start of core 1's code. Reserve 0x4800 more so the regions are disjoint:
# 0x3fce9704 - 0x10000 (IRAM) - 0x14800 = 0x3fcc4f04 < 0x3fcc5000.
config ESP_APPCPU_DRAM_SIZE
	default 0x14800 if ESP_SIMPLE_BOOT

endif

# Core 1 (APPCPU): the display. Its own image, with its own RAM carved out of
# the internal SRAM (see CONFIG_ESP_APPCPU_DRAM_SIZE in the app).
if BOARD_ESP32S3_TOUCH_AMOLED_1_75_ESP32S3_APPCPU

# Interrupt-driven SPI so the CPU is free while a strip goes out by DMA.
config SPI_ESP32_INTERRUPT
	default y
	depends on SPI

endif
